{
  "buildCommand": "node scripts/build-site.js",
  "outputDirectory": "site",
  "routes": [
    {
      "src": "/support",
      "dest": "/docs/index.html"
    },
    {
      "src": "/terms",
      "dest": "/docs/terms.html"
    },
    {
      "src": "/privacy",
      "dest": "/docs/privacy.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "app.creatrr.co"
        }
      ],
      "dest": "/app.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "band.creatrr.co"
        },
        {
          "type": "query",
          "key": "band"
        }
      ],
      "dest": "/band.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "band.creatrr.co"
        }
      ],
      "dest": "/band-home.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "creatrr.co"
        }
      ],
      "dest": "/home.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "www.creatrr.co"
        }
      ],
      "dest": "/home.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/home.html"
    }
  ]
}
