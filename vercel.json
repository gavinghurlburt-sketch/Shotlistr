{
  "installCommand": "true",
  "buildCommand": "rm -rf site && mkdir site && cp index.html landing.html manifest.json service-worker.js site/ && cp -r assets docs icons site/",
  "outputDirectory": "site",
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "band" }], "destination": "/index.html" },
    { "source": "/", "destination": "/landing.html" },
    { "source": "/support", "destination": "/docs/index.html" },
    { "source": "/terms", "destination": "/docs/terms.html" },
    { "source": "/privacy", "destination": "/docs/privacy.html" }
  ]
}
